# === ATLAS ORACLE - Environment Configuration ===

# --- Database ---
# SQLite for local dev, Turso for production
DATABASE_URL="file:./prisma/dev.db"
# DATABASE_URL="libsql://your-db.turso.io?authToken=your-token"

# --- Auth ---
AUTH_SECRET="change-me-to-a-random-32-char-string"
# Generate with: openssl rand -base64 32

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- OAuth (optional - enables social login buttons) ---
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- AI ---
# Optional - app works with deterministic mock predictions without this
OPENAI_API_KEY=""

# --- Email (Resend) ---
# https://resend.com - for password reset / welcome emails
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Atlas Oracle <noreply@yourdomain.com>"
# To verify a custom domain in Resend, add these DNS records:
#   TXT  _resend your-resend-domain-key
#   MX   @  feedback-smtp.your-resend-domain.com (priority 10)
#   TXT  @  "v=spf1 include:resend.com ~all"
#   CNAME resend._domainkey  your-dkim-key.dkim.resend.net

# --- Sentry (error tracking) ---
# https://sentry.io - for error tracking and performance monitoring
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
# To create a Sentry project:
#   1. Go to https://sentry.io → Create Project → Next.js
#   2. Copy the DSN into SENTRY_DSN
#   3. Create an auth token at https://sentry.io/settings/auth-tokens/
#   4. Set SENTRY_ORG to your org slug and SENTRY_PROJECT to the project slug
# Alerting:
#   - Sentry auto-creates an "Alert Rule" for new errors
#   - Configure in Sentry → Alerts → Create Alert Rule
#   - Recommended: error count > 10 in 5 min → notify via email/Slack
