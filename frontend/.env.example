# === A1 QUANTUM ORACLE AI - Environment Configuration ===

# --- Database ---
# SQLite for local dev, Turso for production
DATABASE_URL="file:./data/dev.db"
# DATABASE_URL="libsql://your-db.turso.io?authToken=your-token"

# --- Auth ---
AUTH_SECRET="change-me-to-a-random-32-char-string"
# Generate with: openssl rand -base64 32
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# --- Admins (optional) ---
# Comma-separated emails exempt from the free prediction limit, in addition to
# users whose role is ADMIN. Useful for the creator/testing stage.
ADMIN_EMAILS="admin@a1quantumoracleai.com"

# --- OAuth (optional - enables social login buttons) ---
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- AI ---
# Optional - app works with deterministic mock predictions without this
OPENAI_API_KEY=""

# --- Subscriptions (optional gates) ---
# Require admin approval before PRO activation (default: off)
ADMIN_APPROVAL_REQUIRED="false"
# Require Stripe payment before PRO activation (default: on for production).
# NOTE: the payment gate is currently a guard only — with a valid STRIPE_SECRET_KEY
# set it bypasses to free activation; without one, PRO upgrades return 402.
# A real Stripe checkout integration is not yet implemented.
PAYMENT_GATE_ENABLED="true"
STRIPE_SECRET_KEY=""

# --- Email verification gate (default: off) ---
# When true, new accounts must verify their email before making predictions.
# A verification email with a 24h token is sent on signup; logins remain
# allowed so users can request a new link from /verify-email or settings.
EMAIL_VERIFICATION_REQUIRED="false"

# --- Rate limits (optional tuning; sensible defaults used if unset) ---
LOGIN_RATE_LIMIT_MAX="5"    # login attempts per minute per IP
SIGNUP_RATE_LIMIT_MAX="3"   # signups per minute per IP
RESET_RATE_LIMIT_MAX="3"    # password reset requests per minute per IP

# --- Email (Resend) ---
# https://resend.com - for password reset / welcome emails
RESEND_API_KEY=""
RESEND_FROM_EMAIL="A1 Quantum Oracle AI <noreply@yourdomain.com>"
# To verify a custom domain in Resend, add these DNS records:
#   TXT  _resend your-resend-domain-key
#   MX   @  feedback-smtp.your-resend-domain.com (priority 10)
#   TXT  @  "v=spf1 include:resend.com ~all"
#   CNAME resend._domainkey  your-dkim-key.dkim.resend.net

# --- Sentry (error tracking) ---
# https://sentry.io - for error tracking and performance monitoring
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
# To create a Sentry project:
#   1. Go to https://sentry.io → Create Project → Next.js
#   2. Copy the DSN into SENTRY_DSN
#   3. Create an auth token at https://sentry.io/settings/auth-tokens/
#   4. Set SENTRY_ORG to your org slug and SENTRY_PROJECT to the project slug
# Alerting:
#   - Sentry auto-creates an "Alert Rule" for new errors
#   - Configure in Sentry → Alerts → Create Alert Rule
#   - Recommended: error count > 10 in 5 min → notify via email/Slack
